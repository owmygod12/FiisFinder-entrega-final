# Somente no servidor. Nunca coloque tokens no config.js.
# Vazio permite testes públicos com PETR4, ITUB4, VALE3 e MGLU3.
# PETR3, MXRF11 e ^BVSP exigiram autenticação nos testes deste projeto.
# Após configurar/alterar o token, reinicie a API. Não publique docker compose config.
BRAPI_TOKEN=
PORT=8080
